# Backend environment variables for multitenant-booking-saas
# Copy this file to .env and fill in your values.

# Server
PORT=4000

# Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS origins — comma-separated list of allowed frontend origins.
# Local dev:      http://localhost:5173
# Vercel deploy:  https://your-app.vercel.app
# Both:           http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Log level: error, warn, info, debug, verbose
LOG_LEVEL=info

# SMTP — booking confirmation emails (Phase 8)
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey               ← literally the string "apikey"
#   SMTP_PASSWORD=SG.xxxxxx        ← your SendGrid API key
#   SMTP_FROM_EMAIL=verified@yourdomain.com
#   SMTP_FROM_NAME=Booking SaaS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Booking SaaS
