# ── Server ────────────────────────────────────────────────────────
PORT=
NODE_ENV=

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local:   http://localhost:5173
# Vercel:  https://your-web-project.vercel.app
CORS_ORIGINS=

# ── Logging ───────────────────────────────────────────────────────
# error | warn | info | debug | verbose
LOG_LEVEL=

# ── SMTP (SendGrid or any SMTP provider) ──────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
