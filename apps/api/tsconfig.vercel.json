  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./dist-vercel",
    "incremental": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "api/index.ts"],
